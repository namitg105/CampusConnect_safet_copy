rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =================================================================
    // HELPERS
    // =================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSameCollegeAsEmail(emailField) {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.split('@')[1] == emailField;
    }

    // =================================================================
    // USERS COLLECTION
    // =================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read, write: if isSignedIn();
      }

      match /joinedGroups/{groupId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // =================================================================
    // POSTS COLLECTION (New: College-segregated public posts)
    // =================================================================
    match /posts/{postId} {
      // Read: only if authenticated and the user's email domain matches the post's collegeId
      allow read: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.split('@')[1] == resource.data.collegeId;

      // Create: only if authenticated and posting to your own college
      allow create: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.split('@')[1] == request.resource.data.collegeId
        && request.resource.data.authorId == request.auth.uid;

      // Update: allow author to update post content, and allow vote-count updates for college users
      allow update: if isSignedIn()
        && resource != null
        && (
          request.auth.uid == resource.data.authorId
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'commentCount'])
            && isSameCollegeAsEmail(resource.data.collegeId)
          )
        );

      // Delete: only the original author can delete
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;

      // Votes subcollection: each user can write their own vote document
      match /votes/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.voteValue is int
          && request.resource.data.voteValue >= -1
          && request.resource.data.voteValue <= 1;
        allow delete: if isSignedIn()
          && request.auth.uid == userId;
      }

      // Comments subcollection: allow authenticated users to read and create comments
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId;
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorId;

        // Likes subcollection for comments
        match /likes/{userId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }

    // =================================================================
    // PRIVATE CHAT ROOMS, MESSAGES, & PINNED MESSAGES
    // =================================================================
    match /chat_rooms/{roomId} {
      allow read, write: if isSignedIn()
        && (
          resource == null
          || request.auth.uid in resource.data.participants
          || request.auth.uid in request.resource.data.participants
        );

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }

      // Pinned Message Subcollection
      match /pinned_message/{docId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }
    }

    // =================================================================
    // GROUPS COLLECTION
    // =================================================================
    match /groups/{groupId} {
      allow read, create, update: if isSignedIn();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == memberId;
      }
    }

    // =================================================================
    // GROUP CHATS COLLECTION
    // =================================================================
    match /chats/{groupId}/messages/{messageId} {
      allow read, create: if isSignedIn();
    }
  }
}
